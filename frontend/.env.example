# =============================================================================
# OmniBotIA Studio Frontend - Variables de entorno
# Copia este archivo a .env.local y ajusta los valores de tu entorno local.
# Vite solo expone variables con prefijo VITE_ a import.meta.env.
# =============================================================================

# Nombre de la aplicación (se muestra en el header)
VITE_APP_NAME=OmniBotIA Studio

# Entorno de ejecución: development | staging | production
VITE_APP_ENV=development

# URL base del backend (FastAPI). Sin barra final.
# Usamos el literal IPv4 (127.0.0.1): el backend escucha en IPv4 y esto evita que
# WebKit (Playwright/Windows) resuelva localhost -> ::1 y no encuentre el listener.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Tenant actual para aislamiento multi-tenant
VITE_TENANT_ID=dev-tenant

# Dominio base bajo el que se sirven los subdominios de los tenants (p. ej.
# {tenant}.clientes.omni2.app). Debe coincidir con `client_subdomain_base` del backend.
VITE_CLIENT_SUBDOMAIN_BASE=clientes.omni2.app

# DeepSeek API key. ⚠️ Solo para desarrollo local. En producción vive en el backend.
VITE_DEEPSEEK_API_KEY=

# Feature flags (true|false)
VITE_FEATURE_DRAG_DROP=true
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_CODE_EDITOR=true
VITE_FEATURE_TEMPLATE_MARKETPLACE=false
VITE_FEATURE_DEVELOPER_SCHEMAS=true
VITE_FEATURE_CDN_DEPLOY=true
# Configuración de apariencia del tenant (rebranding): paleta, logo y tipografía
VITE_FEATURE_APPEARANCE=true
# Sección Bots/Conversaciones (Fase 7): proveedores de IA, conversaciones y monitor de cola
VITE_FEATURE_BOTS=true
# Sección Captación/ADS (C-1, eslabón ①): campañas publicitarias con atribución UTM
VITE_FEATURE_ADS=true
# Subsistema CRM (P3): pipeline "Ventas" con Kanban, tareas, SLA y embudo
VITE_FEATURE_CRM=true
# Sección Dominios personalizados (PSEO hosts): dominios propios del tenant para el serving público
VITE_FEATURE_HOSTS=true
# Configurador del Portal del Cliente (modo portal del editor, basado en IA generativa)
VITE_FEATURE_PORTAL=true
