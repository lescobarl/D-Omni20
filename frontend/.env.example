# =============================================================================
# OmniBotIA Studio Frontend - Variables de entorno
# Copia este archivo a .env.local y ajusta los valores de tu entorno local.
# Vite solo expone variables con prefijo VITE_ a import.meta.env.
# =============================================================================

# Nombre de la aplicación (se muestra en el header)
VITE_APP_NAME=OmniBotIA Studio

# Entorno de ejecución: development | staging | production
VITE_APP_ENV=development

# URL base del backend (FastAPI). Sin barra final.
VITE_API_BASE_URL=http://localhost:8000

# Tenant actual para aislamiento multi-tenant
VITE_TENANT_ID=dev-tenant

# DeepSeek API key. ⚠️ Solo para desarrollo local. En producción vive en el backend.
VITE_DEEPSEEK_API_KEY=

# Feature flags (true|false)
VITE_FEATURE_DRAG_DROP=true
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_CODE_EDITOR=true
VITE_FEATURE_TEMPLATE_MARKETPLACE=false
