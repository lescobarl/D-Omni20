# Valores por defecto para el entorno de desarrollo local (committeado).
# Para sobreescribirlos sin afectar a otros, crea .env.local (gitignored).
VITE_APP_NAME=OmniBotIA Studio
VITE_APP_ENV=development
# Literal IPv4: el backend escucha en 127.0.0.1 (evita resolución localhost -> ::1
# que rompe las llamadas API en WebKit/Playwright en Windows).
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_TENANT_ID=dev-tenant
VITE_DEEPSEEK_API_KEY=
VITE_FEATURE_DRAG_DROP=true
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_CODE_EDITOR=true
VITE_FEATURE_TEMPLATE_MARKETPLACE=false
VITE_FEATURE_DEVELOPER_SCHEMAS=true
VITE_FEATURE_CDN_DEPLOY=true
