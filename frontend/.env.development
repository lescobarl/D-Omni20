# Valores por defecto para el entorno de desarrollo local (committeado).
# Para sobreescribirlos sin afectar a otros, crea .env.local (gitignored).
VITE_APP_NAME=OmniBotIA Studio
VITE_APP_ENV=development
# Literal IPv4: el backend escucha en 127.0.0.1 (evita resolución localhost -> ::1
# que rompe las llamadas API en WebKit/Playwright en Windows).
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_TENANT_ID=dev-tenant
# Dominio base de subdominios de tenants (coincide con client_subdomain_base del backend).
VITE_CLIENT_SUBDOMAIN_BASE=clientes.omni2.app
VITE_DEEPSEEK_API_KEY=
VITE_FEATURE_DRAG_DROP=true
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_CODE_EDITOR=true
VITE_FEATURE_TEMPLATE_MARKETPLACE=false
VITE_FEATURE_DEVELOPER_SCHEMAS=true
VITE_FEATURE_CDN_DEPLOY=true
VITE_FEATURE_APPEARANCE=true
# Sección Bots/Conversaciones (Fase 7): el Dashboard operativo (B.1) consume cuota L1,
# cola D3 y últimas conversaciones del servicio de bots, por lo que requiere el flag.
VITE_FEATURE_BOTS=true
VITE_FEATURE_OPERATIONS=true
# Sección Captación/ADS (C-1, eslabón ①): campañas publicitarias con atribución UTM.
VITE_FEATURE_ADS=true
# Subsistema CRM (P3): tab "Ventas" con pipeline Kanban, tareas, SLA y embudo.
VITE_FEATURE_CRM=true
# Sección Dominios personalizados (PSEO hosts): dominios propios del tenant para el serving público.
VITE_FEATURE_HOSTS=true
# Configurador del Portal del Cliente (modo portal del editor, basado en IA generativa).
VITE_FEATURE_PORTAL=true
