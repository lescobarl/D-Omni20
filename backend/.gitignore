# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Entorno (nunca commitees secretos)
.env
.env.local

# Logs (auditoría estructurada)
logs/
*.log
*.jsonl

# Bases de datos locales de desarrollo / testing
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3

# Cobertura
.coverage
htmlcov/

# Ruff / tooling
.ruff_cache/

# Caches de herramientas
.pytest_cache/

# Artefactos generados en tiempo de ejecución (ICS/PDF de workflows)
artifacts/

# Datos de tenant locales
data/

# Artefactos huérfanos / one-off de desarrollo (limpieza seguridad)
portal_check.html
login.json
_dev_server_out.txt

# Certificados TLS locales (mkcert): se generan por desarrollador, nunca se
# commitean (la clave privada es un secreto).
certs/
