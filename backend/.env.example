# =============================================================================
# OmniBotIA Studio - Backend (Fase 2) - Plantilla de variables de entorno
# Copia este archivo a .env (o .env.local) y ajusta valores por entorno.
# NUNCA commitees el .env real (contiene secretos).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────────────────────
# Entorno de ejecución: development | staging | production
BACKEND_ENV=development

# Versión de la API expuesta en /api/v1/health
APP_VERSION=0.2.0

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL con RLS multi-tenant)
# ─────────────────────────────────────────────────────────────────────────────
# Conexión a PostgreSQL (producción / docker-compose)
DATABASE_URL=postgresql://omnibotia:omnibotia@localhost:5432/omnibotia_studio

# Para desarrollo local SIN PostgreSQL (misma app, SQLite):
# DATABASE_URL=sqlite:///./omnibotia_dev.db

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (cache / sesión - fases posteriores)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# IA GENERATIVA (DeepSeek) - SOLO vive en backend, nunca en el frontend
# ─────────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma (Vite dev server por defecto)
CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING ESTRUCTURADO (JSON) + AUDITORÍA
# ─────────────────────────────────────────────────────────────────────────────
# Nivel: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directorio de logs (rotación)
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Ruta del log de auditoría JSONL (inmutable, append-only)
AUDIT_LOG_PATH=logs/audit.jsonl

# ─────────────────────────────────────────────────────────────────────────────
# CONVENIENCIA DE DESARROLLO LOCAL
# ─────────────────────────────────────────────────────────────────────────────
# Crea tablas automáticamente al arrancar (NO usar en producción; usa Alembic)
AUTO_CREATE_TABLES=true

# Tenant de desarrollo auto-creado al arrancar (solo cuando BACKEND_ENV != production)
DEV_TENANT_SLUG=dev-tenant
DEV_TENANT_NAME=Tenant de Desarrollo
