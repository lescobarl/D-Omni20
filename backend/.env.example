# =============================================================================
# OmniBotIA Studio - Backend (Fase 2) - Plantilla de variables de entorno
# Copia este archivo a .env (o .env.local) y ajusta valores por entorno.
# NUNCA commitees el .env real (contiene secretos).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────────────────────
# Entorno de ejecución: development | staging | production
BACKEND_ENV=development

# Versión de la API expuesta en /api/v1/health
APP_VERSION=0.2.0

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL con RLS multi-tenant)
# ─────────────────────────────────────────────────────────────────────────────
# Conexión a PostgreSQL (producción / docker-compose)
DATABASE_URL=postgresql://omnibotia:omnibotia@localhost:5432/omnibotia_studio

# Para desarrollo local SIN PostgreSQL (misma app, SQLite):
# DATABASE_URL=sqlite:///./omnibotia_dev.db

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (cache / sesión - fases posteriores)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# IA GENERATIVA (DeepSeek) - SOLO vive en backend, nunca en el frontend
# ─────────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma (Vite dev server por defecto)
CORS_ORIGINS=http://localhost:5173
# El origen del CDN (derivado de CDN_BASE_URL) se añade automáticamente a CORS
# para que el embed (Fase C) pueda llamar a la API v1 desde las landings PSEO.
# Con allow_credentials=True los orígenes deben ser explícitos (nunca "*").

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING ESTRUCTURADO (JSON) + AUDITORÍA
# ─────────────────────────────────────────────────────────────────────────────
# Nivel: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directorio de logs (rotación)
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Ruta del log de auditoría JSONL (inmutable, append-only)
AUDIT_LOG_PATH=logs/audit.jsonl

# ─────────────────────────────────────────────────────────────────────────────
# CONVENIENCIA DE DESARROLLO LOCAL
# ─────────────────────────────────────────────────────────────────────────────
# Crea tablas automáticamente al arrancar (NO usar en producción; usa Alembic)
AUTO_CREATE_TABLES=true

# Tenant de desarrollo auto-creado al arrancar (solo cuando BACKEND_ENV != production)
DEV_TENANT_SLUG=dev-tenant
DEV_TENANT_NAME=Tenant de Desarrollo

# ─────────────────────────────────────────────────────────────────────────────
# WORKFLOWS (checkout, leads, cotizaciones, citas) + PASARELA DE PAGO
# ─────────────────────────────────────────────────────────────────────────────
# Modo de pasarela: sandbox (determinista, sin credenciales) | live (Stripe)
PAYMENT_MODE=sandbox

# Base del URL de checkout del sandbox y artefactos generados (PDF/ICS)
WORKFLOW_CHECKOUT_BASE_URL=http://localhost:8000/workflows/sandbox/
WORKFLOW_ARTIFACTS_DIR=artifacts
WORKFLOW_ARTIFACTS_BASE_URL=http://localhost:8000/artifacts

# Stripe (solo cuando PAYMENT_MODE=live; vacíos = ConfigValidationError)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/checkout/cancel
STRIPE_TIMEOUT_SECONDS=30.0

# ─────────────────────────────────────────────────────────────────────────────
# CRM AVANZADO (Fase 2 del backlog) - notificación de leads a CRMs externos
# ─────────────────────────────────────────────────────────────────────────────
# Proveedor activo: generic | hubspot | salesforce | zoho
# (vacío/inválido = error de configuración al arrancar, fail-fast)
CRM_PROVIDER=generic

# Mapeo de campos del lead canónico → campos del CRM (JSON string → string).
# Las claves son los campos canónicos (id, tenant_id, name, email, phone,
# source, status, metadata.<clave>, created_at) y los valores el campo destino
# del CRM, con anidación por puntos (ej. "properties.firstname").
# Vacío = enviar todos los campos canónicos tal cual.
# Ejemplo HubSpot:
#   CRM_FIELD_MAPPING_JSON={"name":"properties.firstname","email":"properties.email","phone":"properties.phone"}
CRM_FIELD_MAPPING_JSON=

# Reintentos con backoff exponencial (delay = backoff * 2**(intento-1))
CRM_RETRY_MAX_ATTEMPTS=3
CRM_RETRY_BACKOFF_SECONDS=0.5

# Webhook genérico / URL de respaldo de los adaptadores por proveedor
# (vacío = adaptador no configurado, no notifica y devuelve False).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TIMEOUT_SECONDS=5.0

# ── HubSpot (token privado; envelope {"properties": {...}}) ──────────────────
CRM_HUBSPOT_URL=
CRM_HUBSPOT_TOKEN=

# ── Salesforce (Bearer de instancia; sObject plano) ──────────────────────────
CRM_SALESFORCE_URL=
CRM_SALESFORCE_TOKEN=

# ── Zoho CRM (OAuth token; envelope {"data": [{...}]}) ───────────────────────
CRM_ZOHO_URL=
CRM_ZOHO_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# INTEGRACIONES EXTERNAS (notificaciones y calendario; opcionales)
# ─────────────────────────────────────────────────────────────────────────────
# Todas son opcionales: si quedan vacías, el workflow NO falla, simplemente
# omite la notificación y registra un log con el motivo (best-effort).

# ── Correo SMTP (envío de cotizaciones / confirmaciones por email) ──────────
# Vacío = no enviar correo y devolver False (sin error).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# STARTTLS: true | false (puerto 465 con SSL implícito usa false)
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0

# Directorio de plantillas HTML de email (Jinja2, Fase 4 del backlog).
# Relativo al cwd del backend. Si no existe, el servicio lanza ConfigValidationError.
EMAIL_TEMPLATES_DIR=email_templates

# ── SMS Twilio (aviso de citas y promociones) ────────────────────────────────
# Vacío = no enviar SMS y devolver False (sin error).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número emisor con formato E.164 (ej. +14155552671)
TWILIO_PHONE_NUMBER=
TWILIO_TIMEOUT_SECONDS=10.0

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Vacío = no enviar y devolver False (sin error).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Usado para verificar firmas de webhooks entrantes de Meta
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_TIMEOUT_SECONDS=10.0

# ── Google Calendar (OAuth 2.0) ──────────────────────────────────────────────
# Vacío = solo calendario ICS local (invitaciones descargables).
# Crea credenciales OAuth en Google Cloud Console (tipo "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_TIMEOUT_SECONDS=30.0

# ── Persistencia cifrada de tokens OAuth (Fase 3 del backlog) ───────────────
# Clave simétrica (Fernet, 32 bytes urlsafe base64) para cifrar los tokens
# de Google en reposo (tabla tenant_oauth_tokens). Obligatoria en producción
# (fail-fast al arrancar); en desarrollo vacía = sin persistencia de tokens.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
