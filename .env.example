# =============================================================================
# OmniBotIA Studio - Variables de entorno (Plantilla)
# Copia este archivo a .env y completa los valores según el entorno.
# NUNCA commitear el archivo .env real (contiene secretos).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite expone solo variables con prefijo VITE_ a import.meta.env)
# ─────────────────────────────────────────────────────────────────────────────
# Nombre de la aplicación (se muestra en el header)
VITE_APP_NAME=OmniBotIA Studio

# Entorno de ejecución: development | staging | production
VITE_APP_ENV=development

# URL base del backend (FastAPI). Sin barra final.
VITE_API_BASE_URL=http://localhost:8000

# Tenant actual para aislamiento multi-tenant (Fase 2+ lo gestiona por auth)
VITE_TENANT_ID=dev-tenant

# DeepSeek API key. ⚠️ En producción esta clave debe vivir SOLO en el backend.
# El frontend nunca debe exponerla. Aquí se documenta para desarrollo local.
VITE_DEEPSEEK_API_KEY=

# Feature flags (true|false)
VITE_FEATURE_DRAG_DROP=true
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_CODE_EDITOR=true
VITE_FEATURE_TEMPLATE_MARKETPLACE=false

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (Fase 2 - FastAPI / PostgreSQL / Redis)
# ─────────────────────────────────────────────────────────────────────────────
# Conexión a PostgreSQL
DATABASE_URL=postgresql://omnibotia:omnibotia@localhost:5432/omnibotia_studio

# Conexión a Redis
REDIS_URL=redis://localhost:6379/0

# Nivel de logging estructurado: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Entorno del backend
BACKEND_ENV=development

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Clave de cifrado Fernet para persistir tokens OAuth de Google en reposo
# (Fase 3). Obligatoria cuando BACKEND_ENV=production (fail-fast).
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Directorio de plantillas HTML de email (Jinja2, Fase 4 del backlog).
# Relativo al cwd del backend (omnibotia-studio/backend/email_templates).
EMAIL_TEMPLATES_DIR=email_templates

# ─────────────────────────────────────────────────────────────────────────────
# BOT OMNIBOTIA (Fase 3) - núcleo del bot y context bundle m2m
# ─────────────────────────────────────────────────────────────────────────────
# URL base de la API de OmniBotIA (el bot OmniBot_IA se conecta como cliente
# m2m a este backend para resolver la configuración de cada canal).
OMNI2_API_BASE_URL=http://localhost:8000

# Credencial de servicio m2m (service tenant) que el bot presenta en el header
# Authorization: Bearer <OMNI2_SERVICE_CREDENTIAL> al consumir /api/v1/bot/context.
# Vacía = deshabilitado (el cliente falla con DependencyError al hacer fetch).
OMNI2_SERVICE_CREDENTIAL=

# Feature flag global del bot (true | false)
BOT_FEATURE_ENABLED=true

# Timeout (segundos) del fetch del context bundle por canal
BOT_CONTEXT_TIMEOUT_SECONDS=10.0

# Prefijo de los streams Redis de la cola de mensajes del bot (Fase 5.1)
BOT_QUEUE_STREAM_PREFIX=bot:queue

# Nombre del grupo de consumidores del worker del bot (Fase 5.1)
BOT_WORKER_GROUP=bot-workers
