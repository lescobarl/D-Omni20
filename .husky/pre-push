#!/usr/bin/env sh
# OmniBotIA Studio - pre-push (gate de entrega)
# La suite completa (`test:full`) se ejecuta UNA vez por push (entrega), no en
# cada commit. Mantiene la validación total del hito sin penalizar la iteración.
cd "$(dirname "$0")/../frontend" || exit 1
echo "pre-push: puerta de tipos + suite completa (test:full)..."
npm run typecheck
npm run test:full
